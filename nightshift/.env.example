# Copy to .env and fill in. .env is gitignored. Model keys, GitHub and Jira OAuth live inside TrueForge, not here.
SHOP_PATH=/absolute/path/to/astronomy-shop
REPO_ROOT=/absolute/path/to/the/folder/holding/nightshift/and/astronomy-shop
OPS_MCP_TOKEN=            # openssl rand -hex 24
SHOP_DB_ADMIN_PASSWORD=   # POSTGRES_PASSWORD from the shop's .env
SHOP_DB_RO_PASSWORD=      # openssl rand -hex 16 (read-only SQL role for the agents)
NIGHTSHIFT_DB_RO_PASSWORD= # openssl rand -hex 16 (read-only view of past incidents for the agents)
SLACK_WEBHOOK_URL=
DATABASE_URL=postgresql://nightshift:nightshift@localhost:5433/nightshift
REDIS_URL=redis://localhost:6380/0
TRUEFORGE_BASE_URL=http://localhost:8790
PROMETHEUS_URL=http://localhost:9090
OPS_MCP_URL=http://localhost:8000/mcp
DEMO_MODE=true            # 30 s alert window instead of 2 min, demo scenario endpoint on
INCIDENT_BUDGET_USD=2.0   # escalate when one incident costs more than this
JIRA_BASE_URL=            # https://<site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=SRE
