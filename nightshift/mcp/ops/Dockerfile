FROM python:3.12-slim
# docker CLI + compose plugin, to rebuild and swap the target system's containers
COPY --from=docker:29-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY ops_mcp ./ops_mcp
EXPOSE 8000
CMD ["python", "-m", "ops_mcp.server"]
